{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "description": "THIS FILE WAS AUTOMATICALLY GENERATED BY KRES, PLEASE DO NOT EDIT.",
    "prHeader": "Update Request | Renovate Bot",
    "extends": [
        ":dependencyDashboard",
        ":gitSignOff",
        ":semanticCommitScopeDisabled",
        "schedule:nonOfficeHours"
    ],
    "customManagers": [
        {
            "customType": "regex",
            "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver{{/if}}",
            "managerFilePatterns": [
                "/Pkgfile/"
            ],
            "matchStrings": [
                "# renovate: datasource=(?<datasource>.*?)(?:\\s+extractVersion=(?<extractVersion>.+?))?(?:\\s+versioning=(?<versioning>.+?))?\\s+depName=(?<depName>.+?)?\\s(?:.*_(?:version|VERSION):\\s+\"?(?<currentValue>[^\"\\s]+)\"?)?(?:(\\s)?.*_(?:ref|REF):\\s+(?<currentDigest>.*))?"
            ]
        },
        {
            "customType": "regex",
            "datasourceTemplate": "github-tags",
            "depNameTemplate": "siderolabs/bldr",
            "versioningTemplate": "semver",
            "managerFilePatterns": [
                "/Pkgfile/"
            ],
            "matchStrings": [
                "ghcr.io\\/siderolabs\\/bldr:(?<currentValue>v.*)"
            ]
        }
    ],
    "packageRules": [
        {
            "groupName": "dependencies",
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch",
                "pin",
                "digest"
            ]
        },
        {
            "enabled": false,
            "matchFileNames": [
                "Dockerfile"
            ]
        },
        {
            "enabled": false,
            "matchFileNames": [
                ".github/workflows/*.yaml"
            ]
        },
        {
            "versioning": "regex:^((?<compatibility>\\S+)-)?v(?<major>\\d+)\\.(?<minor>\\d+)\\.?(?<patch>\\d+)?$",
            "matchPackageNames": [
                "ARM-software/arm-trusted-firmware"
            ]
        },
        {
            "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(?<prerelease>-rc\\d+)?$",
            "matchPackageNames": [
                "u-boot/u-boot"
            ]
        }
    ],
    "separateMajorMinor": false,
    "draftPR": true
}
